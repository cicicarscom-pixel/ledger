-
-function Player({ position }: { position: THREE.Vector3 }) {
-  const ref = useRef<THREE.Mesh>(null!);
-
-  useFrame(() => {
-    ref.current.position.copy(position);
-  });
-
-  return (
-    <mesh ref={ref}>
-      <coneGeometry args={[0.5, 1, 8]} />
-      <meshStandardMaterial color="#00ffff" />
-    </mesh>
-  );
