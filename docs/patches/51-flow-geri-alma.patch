-SETTLE="${4:-8}"
-SERVER_TIMEOUT="${EXPO_SKILL_EVAL_BUNDLE_TIMEOUT:-240}"
-LOG="${OUT%.png}.metro.log"
-
-mkdir -p "$(dirname "$OUT")"
-
-# Free the port up front in case a previous run (or a crash) left Metro on it,
