+    _get_customers_org: () => ({ data: CUSTOMERS }),
+    _get_customer_appointments_org: () => ({ data: [{ id: "a1", starts_at: "2026-10-08T09:30:00Z", doctor: "Dr.Salih GÜNEY", request: "Kontrol", status: "Approved", source: "whatsapp" }] }),
