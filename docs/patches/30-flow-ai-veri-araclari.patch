+  assertEquals(calls[0].args, { p_org: "ORG-A" });
+  const d = r.data as any;
+  assertEquals(d.totalMatching, 2);
+  assertEquals(d.customers.map((c: any) => c.name), ["Ahmet Yavuz", "Ahmet Kaya"]);
